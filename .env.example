# Local dev (npm run dev via server.ts) needs none of this — the app and the
# socket layer share one process on the same origin.
#
# For a split deployment (Next.js on Vercel + socket-server.ts elsewhere,
# e.g. Render/Railway/Fly.io), set these instead:

# Public URL of the deployed socket-server.ts, used by the browser client.
# Leave empty for same-origin (local dev / single-host deployments).
NEXT_PUBLIC_SOCKET_URL=

# --- Vars below are read by socket-server.ts itself, not the Next.js app ---

# Origin(s) allowed to connect to the socket server, comma-separated.
# Set this to your Vercel app's URL once you know it; "*" works to get
# a first deploy running but should be locked down afterwards.
CLIENT_ORIGIN=*

# Port the socket server listens on. Most hosts set this automatically.
PORT=4000
